# --- CERTIFICADOS mTLS (apenas producao) ---
# Caminho dos certificados para producao
ITAU_CERT_PATH=/etc/ssl/certs/itau-cert.pem
ITAU_KEY_PATH=/etc/ssl/private/itau-key.pem
ITAU_CA_PATH=/etc/ssl/certs/itau-ca.pem

# --- ODOO ---
ODOO_URL=https://seu-empresa.odoo.com
ODOO_DB=seu-empresa
ODOO_USERNAME=seu-email@empresa.com
ODOO_API_KEY=sua-api-key-do-odoo

# --- MODO MOCK (true para testar sem o Itau) ---
MOCK_MODE=true

# --- MIDDLEWARE ---
PORT=3000
API_SECRET_KEY=gerar-uma-chave-secreta-super-forte-aqui

# --- WEBHOOK ---
WEBHOOK_SECRET=gerar-outra-chave-para-validar-webhooks
