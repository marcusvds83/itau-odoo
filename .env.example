# --- LINK DE PAGAMENTO ITAU (CARTOES) ---
LINK_PAG_CLIENT_ID=e3713650-f520-48cd-ab1d-27a903cafe19
LINK_PAG_CLIENT_SECRET=7W51I2Wzrj
# Se a API de Link de Pagamento tiver URLs proprias, descomente:
# LINK_PAG_SANDBOX_URL=https://sandbox.devportal.itau.com.br/...
# LINK_PAG_PRODUCAO_URL=https://api.itau.com.br/...
